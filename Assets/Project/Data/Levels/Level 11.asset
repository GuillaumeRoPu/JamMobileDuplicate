  m_Name: Level 11
  m_EditorClassIdentifier: Assembly-CSharp::LevelData
  <GridLevel>k__BackingField: {fileID: 11400000, guid: bc119757575b29c4a87c34b79f397279, type: 2}
  <TurnMax>k__BackingField: 30
  <Events>k__BackingField:
  - Turn: 1
    EventType: 3
    SpawnCellIndex: 2
  - Turn: 3
    EventType: 0
    SpawnCellIndex: 1
  <TrapToUse>k__BackingField:
